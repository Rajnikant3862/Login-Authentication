# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file.

# Secret key used to sign JWT access tokens (generate a long random string).
SECRET_KEY=your_long_random_secret_here

# JWT signing algorithm.
ALGORITHM=HS256

# MongoDB connection string (e.g. from MongoDB Atlas).
MONGODB_URL_KEY="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/"

# Database and collection names.
DATABASE_NAME=UserDatabase
USER_COLLECTION_NAME=User
EMBEDDING_COLLECTION_NAME=Embedding
